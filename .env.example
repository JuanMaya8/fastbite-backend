# Reference of the environment variables the server understands.
# Locally you do NOT need any of them: the defaults work out of the box.
# In production (Render) set them in the dashboard.

# Port for browser traffic (gRPC-Web / Connect). Render sets this automatically.
PORT=8080

# Extra port that speaks NATIVE gRPC (HTTP/2). Used by `npm run demo`.
# Enabled by default outside production (50051). Leave unset on Render.
# GRPC_PORT=50051

# Comma separated list of frontend origins allowed to call the API.
# In production use your Vercel URL, e.g. https://fastbite.vercel.app
# If empty, every origin is allowed (fine for local development only).
CORS_ORIGIN=http://localhost:5173

# Delivery simulation speed. 1 = about 25 seconds per order, 5 = five times faster.
SIMULATION_SPEED=1
